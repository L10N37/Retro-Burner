#define HOST_CPU "@CMAKE_SYSTEM_PROCESSOR@"
#define HOST_VENDOR "RetroBurner"
#define HOST_OS "@CMAKE_SYSTEM_NAME@"


/* RETROBEAM_LINUX_LIBC_CONTRACT_V5
 *
 * Modern Linux/glibc contract for the inherited Schily portability layer.
 * These replace configure-era xconfig probes for RetroBeam's supported
 * Linux target. Do not apply this block to Windows.
 */
#if defined(__linux__)

#define HAVE_STDARG_H 1
#define HAVE_LIMITS_H 1
#define HAVE_FCNTL_H 1
#define HAVE_DIRENT_H 1
#define HAVE_GRP_H 1
#define HAVE_PWD_H 1
#define HAVE_LOCALE_H 1
