/* RETROBEAM_LINUX_LIBC_CONTRACT_V6 */

/*
 * Fedora/glibc already supplies these interfaces. The corresponding
 * libschily source files are portability fallbacks and should compile to
 * empty objects on the supported Linux target.
 */
#define HAVE_LIBGEN_H 1
#define HAVE_BASENAME 1
#define HAVE_DIRNAME 1

#define HAVE_FSTATAT 1
#define HAVE_OPENAT 1
#define HAVE_UTIMENSAT 1
#define HAVE_FUTIMENS 1
#define HAVE_LSTAT 1

#define HAVE_SIGNAL_H 1
#define HAVE_SYS_WAIT_H 1
#define HAVE_TYPE_SIGINFO_T 1
#define HAVE_TYPE_IDTYPE_T 1

#define HAVE_STRCHR 1
#define HAVE_STRRCHR 1
#define HAVE_STRSTR 1

#define HAVE_WCSCHR 1
#define HAVE_WCSRCHR 1
#define HAVE_WCSSTR 1
#define HAVE_WCSTOL 1

/*
 * Schily's fexec* and getline APIs pre-date the later POSIX functions with
 * colliding names. These RAW_* markers are the upstream mechanism that
 * makes system headers get included before the Schily aliases are installed.
 */
#define HAVE_RAW_FEXECVE 1
#define HAVE_RAW_GETLINE 1

/*
 * Stage 2 temporarily disabled Schily's fexec aliases to get past a missing
 * configure result. The RAW_FEXECVE route above is the proper Linux fix.
 */
#ifdef NO_SCHILY_FEXEC
#undef NO_SCHILY_FEXEC
#endif

#endif /* __linux__ */

#define IS_SCHILY_XCONFIG 1

