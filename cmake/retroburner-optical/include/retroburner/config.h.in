#define HAVE_STRING_H 1
#define HAVE_STDLIB_H 1
#define HAVE_TIME_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_IOCTL_H 1
/* RETROBEAM_LINUX_FIFO_FACTS_V14 */
/*
 * Native Linux cdrecord FIFO requirements.
 * fifo.c keeps FIFO enabled only when both a shared-memory mechanism
 * and fork() were detected by the historical Schily configure probes.
 * CMake supplies those probe results explicitly.
 */
#if defined(__linux__)
#define HAVE_FORK 1
#define HAVE_SMMAP 1
#endif

/* RETROBEAM_LINUX_SG_HEADER_PROBES_V11 */
#define HAVE_SCSI_SCSI_H 1
#define HAVE_SCSI_SG_H 1
/* Old Schily libscg selects Linux with the historical 'linux' macro. */
#ifndef linux
#define linux 1
#endif
#define HAVE_SYS_PARAM_H 1
#define HAVE_NETDB_H 1
#define HAVE_UTSNAME_H 1
/* RETROBEAM_LINUX_SYS_UTSNAME_V8 */
#define HAVE_SYS_UTSNAME_H 1
/* RETROBEAM_LINUX_VA_LIST_ARRAY_V10 */
#if defined(__linux__) && defined(__x86_64__)
#define VA_LIST_IS_ARRAY 1
